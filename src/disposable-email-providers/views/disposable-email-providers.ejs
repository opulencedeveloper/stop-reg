            <span class="active" onclick="setDnsTab('mx', this)">MX Records</span>
            <span onclick="setDnsTab('spf', this)">SPF</span>
            <span onclick="setDnsTab('dmarc', this)">DMARC</span>
            <span onclick="setDnsTab('dkim', this)">DKIM</span>
            <span onclick="setDnsTab('a', this)">A/AAAA</span>
            <span onclick="setDnsTab('ns', this)">NS</span>
            <span onclick="setDnsTab('soa', this)">SOA</span>
            <span onclick="setDnsTab('txt', this)">TXT</span>
            <span onclick="setDnsTab('dnssec', this)">DNSSEC</span>
          </div>
          <div class="dns-scroll">
            <table class="dns-table">
              <thead>
                <tr>
                  <th>Priority</th>
                  <th>Host</th>
                  <th>Mail Server</th>
                  <th>TTL</th>
                </tr>
              </thead>
              <tbody id="mx-records-tbody">
                <% const mxRecords = (typeof dnsData !== 'undefined' && dnsData && dnsData.mxRecords) ? dnsData.mxRecords : []; %>
