<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof metaTitle !== 'undefined' && metaTitle ? metaTitle : 'StopReg Programmatic SEO Directory' %></title>
  <meta name="description"
    content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Explore email providers, disposable email domains, domain intelligence and subdomain data with StopReg.' %>">
  <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : 'https://stopreg.com/providers' %>" />
  <link rel="icon" type="image/x-icon" href="/assets/icons/favicon.ico" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
  <link rel="preconnect" href="https://salesiq.zohopublic.com" />
  <link rel="dns-prefetch" href="https://salesiq.zohopublic.com" />

  <!-- Stylesheets -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/izitoast/dist/css/iziToast.min.css" />

  <!-- Preload Critical Fonts -->
  <link rel="preload" href="/assets/fonts/PlusJakartaSans-Regular.woff2" as="font" type="font/woff2"
    crossorigin="anonymous" />
  <link rel="preload" href="/assets/fonts/PlusJakartaSans-Bold.woff2" as="font" type="font/woff2"
    crossorigin="anonymous" />
  <link href="/assets/css/fonts.css" rel="stylesheet" />
  <link href="/assets/css/variables.css" rel="stylesheet" />
  <link href="/assets/css/styles.css" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/disposable-email-providers.css">
  <link href="/assets/css/entrance-overlay.css" rel="stylesheet" />
  <link href="/assets/css/landing/header.css" rel="stylesheet" />
  <link href="/assets/css/landing/index.css" rel="stylesheet" />


  <script src="https://cdn.jsdelivr.net/npm/izitoast/dist/js/iziToast.min.js" defer></script>


</head>

<body>

  <!-- Mobile Navigation Start -->
  <div class="nav-menu">
    <div class="nav-menu-sect-one">
      <a href="/" class="land-logo" aria-label="StopReg Home">
        <img src="/assets/logo/stopreg-logo.svg" alt="StopReg - Block Disposable Email Addresses" />
      </a>
      <div class="nav-icon2-mobile active">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
    <div class="mobile-nav-items">
      <a href="/#what-stopreg-check">Feature</a>
      <a href="/#api">API</a>
      <a href="/#pricing">Pricing</a>
      <a href="/#fags">FAQs</a>
      <a href="/documentation.html">Documentation</a>
    </div>
    <div class="mobile-nav-btns">
      <a href="/sign-in.html" style="text-decoration:none; flex:1;" class="mobile-nav-btn-link">Log In</a>
      <a href="/sign-up.html" style="text-decoration:none; flex:1;" class="mobile-nav-btn-link">Create an Account</a>
    </div>
  </div>
  <!-- Mobile Navigation End -->

  <!-- Header Start -->
  <header class="main-head-cont">
    <div class="main-head-wrapper box animation6">
      <a href="/" class="land-logo" aria-label="StopReg Home">
        <img src="/assets/logo/stopreg-logo.svg" alt="StopReg - Block Disposable Email Addresses" />
      </a>
      <nav class="nav-wrapper">
        <a href="/#what-stopreg-check">Feature</a>
        <a href="/#api">API</a>
        <a href="/#pricing">Pricing</a>
        <a href="/#fags">FAQs</a>
        <a href="/documentation.html">Documentation</a>
      </nav>
      <div class="auth-wrapper">
        <a href="/sign-in.html" class="auth-btn-link">Log In</a>
        <a href="/sign-up.html" class="auth-btn-link">Create an Account</a>
      </div>

      <div class="nav-icon2">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </header>
  <!-- Header End -->

  <main>
    <div class="container">
      <!-- TIER 1 -->
      <section id="providers"
        class="page <%= (typeof activeView !== 'undefined' && activeView === 'providers') ? 'active' : '' %>">
        <div class="breadcrumb"><a href="/providers">StopReg</a><span>/</span><span>Providers</span>
        </div>
        <div class="hero">
          <h1>Disposable Email Providers</h1>
          <p>Explore disposable and temporary email providers and view the domains associated with each provider. Open a
            provider to explore its domain portfolio.</p>
        </div>
        <div class="card">
          <div class="toolbar">
            <div class="controls">

              <div class="viewtoggle"><button class="active"
                  onclick="setView('providers','table',this)">Table</button><button
                  onclick="setView('providers','grid',this)">Grid</button></div>
            </div>
          </div>

          <div id="providers-table" class="tableview">
            <div class="tablewrap">
              <table class="table">
                <thead>
                  <tr>
                    <th>Provider</th>
                    <th>Domains</th>
                    <th>Subdomains</th>
                    <th>Updated</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% if (typeof providers !=='undefined' && providers && providers.length> 0) { %>
                    <% providers.forEach(function(item) { %>
                      <tr data-search="<%= (item.provider || '').toLowerCase() %>">
                        <td><a href="/provider/<%= encodeURIComponent(item.provider) %>">
                            <div class="primarytext">
                              <%= item.provider %>
                            </div>
                            <div class="subtext">Disposable email provider</div>
                          </a></td>
                        <td>
                          <%= item.domainsCount || 1 %>
                        </td>
                        <td>
                          <%= item.subdomainsCount || 0 %>
                        </td>
                        <td>
                          <%= item.updatedAt ? new Date(item.updatedAt).toLocaleDateString() : 'Active' %>
                        </td>
                        <td><a class="arrow"
                            href="/provider/<%= encodeURIComponent(item.provider) %>">View
                            →</a></td>
                      </tr>
                      <% }); %>
                        <% } else { %>
                          <tr>
                            <td colspan="6" style="text-align:center;padding:30px;color:var(--muted)">No disposable
                              providers found.</td>
                          </tr>
                          <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <div id="providers-grid" class="gridview hidden">
            <% if (typeof providers !=='undefined' && providers && providers.length> 0) { %>
              <% providers.forEach(function(item) { %>
                <a class="itemcard" href="/provider/<%= encodeURIComponent(item.provider) %>"
                  data-search="<%= (item.provider || '').toLowerCase() %>">
                  <div class="itemtop">
                    <div class="itemicon">
                      <%= (item.provider || 'D' )[0].toUpperCase() %>
                    </div>
                    <span class="badge red">
                      <%= item.type || 'Disposable' %>
                    </span>
                  </div>
                  <h3>
                    <%= item.provider %>
                  </h3>
                  <p>Temporary email provider with <%= item.domainsCount || 1 %> associated <%= (item.domainsCount===1)
                        ? 'domain' : 'domains' %>.</p>
                  <div class="itemmeta">
                    <span>
                      <%= item.domainsCount || 1 %>
                        <%= (item.domainsCount===1) ? 'domain' : 'domains' %>
                    </span>
                    <b class="arrow">View →</b>
                  </div>
                </a>
                <% }); %>
                  <% } else { %>
                    <div style="grid-column:1/-1;text-align:center;padding:30px;color:var(--muted)">No disposable
                      providers found.</div>
                    <% } %>
          </div>
          <div class="pagination">
            <span class="muted">
              <% if (typeof pagination !=='undefined' && pagination && pagination.total> 0) { %>
                Showing <%= ((pagination.page - 1) * pagination.limit) + 1 %>–<%= Math.min(pagination.page *
                    pagination.limit, pagination.total) %> of <%= pagination.total.toLocaleString() %> disposable
                      providers
                      <% } else { %>
                        Showing 0 disposable providers
                        <% } %>
            </span>
            <div class="pages">
              <% if (typeof pagination !=='undefined' && pagination && pagination.page> 1) { %>
                <button
                  data-href="/providers?page=<%= pagination.page - 1 %><% if (typeof searchQuery !== 'undefined' && searchQuery) { %>&search=<%= encodeURIComponent(searchQuery) %><% } %>"
                  onclick="window.location.href=this.dataset.href">Previous</button>
                <% } else { %>
                  <button disabled style="opacity:0.5;cursor:not-allowed">Previous</button>
                  <% } %>
                    <% if (typeof pagination !=='undefined' && pagination && pagination.page < pagination.totalPages) {
                      %>
                      <button
                        data-href="/providers?page=<%= pagination.page + 1 %><% if (typeof searchQuery !== 'undefined' && searchQuery) { %>&search=<%= encodeURIComponent(searchQuery) %><% } %>"
                        onclick="window.location.href=this.dataset.href">Next</button>
                      <% } else { %>
                        <button disabled style="opacity:0.5;cursor:not-allowed">Next</button>
                        <% } %>
            </div>
          </div>
        </div>
        <div class="cta">
          <h2>Find disposable email providers before signup</h2>
          <p>StopReg maps disposable and temporary email providers to their associated domains, helping you identify
            temporary email infrastructure before it becomes a source of signup abuse.</p><a class="btn"
            href="/documentation">Explore API</a>
        </div>

      </section>

      <!-- TIER 2 -->
      <section id="domains"
        class="page <%= (typeof activeView !== 'undefined' && activeView === 'domains') ? 'active' : '' %>">
        <div class="breadcrumb"><a href="/providers">StopReg</a><span>/</span><a
            href="/providers">Providers</a>
          <% if (typeof selectedProvider !=='undefined' && selectedProvider) { %><span>/</span><span>
              <%= selectedProvider %>
            </span><span>/ Domains</span>
            <% } %>
        </div>
        <div class="hero providerhero">
          <div>
            <h1>
              <%= (typeof selectedProvider !=='undefined' && selectedProvider) ? (selectedProvider + ' Domains' )
                : 'Provider Domains' %>
            </h1>
            <p>
              <%= (typeof selectedProvider !=='undefined' && selectedProvider) ? `Browse the domains associated with
                ${selectedProvider} and open detailed StopReg intelligence for each domain.`
                : 'Browse domains associated with disposable email providers.' %>
            </p>
          </div>

        </div>
        <div class="card">
          <div class="toolbar">
            <div class="controls">
              <div class="subdomain-count"><span>Total domains</span><strong>
                  <%= (typeof providerDomainsPagination !=='undefined' && providerDomainsPagination.total) ?
                    providerDomainsPagination.total.toLocaleString() : (typeof providerDomains !=='undefined' ?
                    providerDomains.length : 0) %>
                </strong></div>
              <div class="viewtoggle"><button class="active"
                  onclick="setView('domains','table',this)">Table</button><button
                  onclick="setView('domains','grid',this)">Grid</button></div>
            </div>
          </div>
          <div id="domains-table" class="tableview">
            <div class="tablewrap">
              <table class="table">
                <thead>
                  <tr>
                    <th>Domain</th>
                    <th>Subdomains</th>
                    <th>MX</th>
                    <th>Last checked</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% if (typeof providerDomains !=='undefined' && providerDomains && providerDomains.length> 0) { %>
                    <% providerDomains.forEach(function(d) { %>
                      <tr data-search="<%= (d.domain || '').toLowerCase() %>">
                        <td><a
                            href="/domain/<%= encodeURIComponent(d.domain) %>">
                            <div class="primarytext">
                              <%= d.domain %>
                            </div>
                            <div class="subtext">Disposable domain</div>
                          </a></td>
                        <td>
                          <%= (typeof d.subdomainsCount !=='undefined' && d.subdomainsCount !==null && d.subdomainsCount
                            !=='null' ) ? d.subdomainsCount : 0 %>
                        </td>
                        <td><span class="badge gray mx-status" data-mx-domain="<%= d.domain %>">Checking…</span></td>
                        <td>
                          <%= d.createdAt ? new Date(d.createdAt).toLocaleDateString() : 'Active' %>
                        </td>
                        <td><a class="arrow"
                            href="/domain/<%= encodeURIComponent(d.domain) %>">View
                            →</a></td>
                      </tr>
                      <% }); %>
                        <% } else { %>
                          <tr>
                            <td colspan="6" style="text-align:center;padding:30px;color:var(--muted)">No domains
                              registered for this provider yet.</td>
                          </tr>
                          <% } %>
                </tbody>
              </table>
            </div>
          </div>
          <div id="domains-grid" class="gridview hidden">
            <% if (typeof providerDomains !=='undefined' && providerDomains && providerDomains.length> 0) { %>
              <% providerDomains.forEach(function(d) { %>
                <a class="itemcard"
                  href="/domain/<%= encodeURIComponent(d.domain) %>"
                  data-search="<%= (d.domain || '').toLowerCase() %>">
                  <div class="itemtop">
                    <div><span class="eyebrow">DOMAIN</span>
                      <h3 style="margin-top:8px">
                        <%= d.domain %>
                      </h3>
                    </div>
                    <span class="badge red">Disposable</span>
                  </div>
                  <p>Disposable email domain associated with <%= (typeof selectedProvider !=='undefined' &&
                      selectedProvider) ? selectedProvider : 'the provider' %>.</p>
                  <div class="itemmeta">
                    <span>
                      <%= (typeof selectedProvider !=='undefined' && selectedProvider) ? selectedProvider : 'Provider'
                        %>
                    </span>
                    <b class="arrow">Details →</b>
                  </div>
                </a>
                <% }); %>
                  <% } else { %>
                    <div style="grid-column:1/-1;text-align:center;padding:30px;color:var(--muted)">No domains found.
                    </div>
                    <% } %>
          </div>
          <div class="pagination">
            <span class="muted">
              <% if (typeof providerDomainsPagination !=='undefined' && providerDomainsPagination.total> 0) { %>
                Showing <%= ((providerDomainsPagination.page - 1) * providerDomainsPagination.limit) + 1 %>–<%=
                    Math.min(providerDomainsPagination.page * providerDomainsPagination.limit,
                    providerDomainsPagination.total) %> of <%= providerDomainsPagination.total.toLocaleString() %>
                      domains
                      <% } else { %>
                        Showing 0 domains
                        <% } %>
            </span>
            <div class="pages">
              <% if (typeof providerDomainsPagination !=='undefined' && providerDomainsPagination.page> 1) { %>
                <button
                  data-href="/provider/<%= encodeURIComponent(selectedProvider || '') %>?domainPage=<%= providerDomainsPagination.page - 1 %>"
                  onclick="window.location.href=this.dataset.href">Previous</button>
                <% } else { %>
                  <button disabled style="opacity:0.5;cursor:not-allowed">Previous</button>
                  <% } %>
                    <% if (typeof providerDomainsPagination !=='undefined' && providerDomainsPagination.page <
                      providerDomainsPagination.totalPages) { %>
                      <button
                        data-href="/provider/<%= encodeURIComponent(selectedProvider || '') %>?domainPage=<%= providerDomainsPagination.page + 1 %>"
                        onclick="window.location.href=this.dataset.href">Next</button>
                      <% } else { %>
                        <button disabled style="opacity:0.5;cursor:not-allowed">Next</button>
                        <% } %>
            </div>
          </div>
        </div>
        <div class="card">
          <h2>About <%= (typeof selectedProvider !=='undefined' && selectedProvider) ? selectedProvider : 'provider' %>
              domains</h2>
          <p>This directory contains domains associated with the provider. Each domain has an individual StopReg page
            containing classification signals, mail infrastructure information and discovered subdomains.</p>
        </div>

        <div class="cta get-started">
          <h2>Get Started with 200 Free Requests Every Month</h2>
          <p class="get-started-text">Start protecting your signup forms with StopReg email intelligence. Test
            disposable, relay, alias and other
            risky email addresses before creating accounts.</p>
          <a class="btn" href="/sign-up.html">Get Started Free →</a>
        </div>

      </section>

      <!-- TIER 3 -->
      <section id="domain"
        class="page <%= (typeof activeView !== 'undefined' && activeView === 'domain') ? 'active' : '' %>">
        <% const breadcrumbProvider = (typeof selectedProvider !== 'undefined' && selectedProvider) || (typeof domainDetails !== 'undefined' && domainDetails && domainDetails.provider) || null; %>
        <div class="breadcrumb"><a href="/">StopReg</a><span>/</span><a href="/providers">Providers</a>
          <% if (breadcrumbProvider) { %><span>/</span><a
              href="/provider/<%= encodeURIComponent(breadcrumbProvider) %>">
              <%= breadcrumbProvider %>
            </a>
            <% } %>
              <% if (typeof selectedDomain !=='undefined' && selectedDomain) { %><span>/</span><span>
                  <%= selectedDomain %>
                </span>
                <% } %>
        </div>
        <div class="hero domainhero">
          <div>
            <h1>
              <%= (typeof selectedDomain !=='undefined' && selectedDomain) ? selectedDomain : 'Domain Intelligence' %>
            </h1>
            <p>
              <%= (typeof selectedDomain !=='undefined' && selectedDomain) ? `Complete StopReg analysis for
                ${selectedDomain}, including DNS, mail infrastructure and classification.`
                : 'Select a domain to inspect StopReg intelligence.' %>
            </p>


          </div>
          <% let statusClass='status-standard' ; let statusTitle='Standard Email' ; if (typeof domainDetails
            !=='undefined' && domainDetails && domainDetails.classification) { if
            (domainDetails.classification.is_disposable) { statusClass='status-disposable' ;
            statusTitle='Disposable Domain' ; } else if (domainDetails.classification.is_relay) {
            statusClass='status-relay' ; statusTitle='Email Relay' ; } else if (domainDetails.classification.is_private)
            { statusClass='status-private' ; statusTitle='Private Email' ; } } %>
            <div class="statusbox <%= statusClass %>">
              <div class="statusicon">!</div>
              <div>
                <strong>
                  <%= statusTitle %>
                </strong><br><small>StopReg classification</small>
              </div>
            </div>
        </div>

        <div class="card domain-overview">
          <div class="eyebrow">DOMAIN OVERVIEW</div>
          <h2 style="margin-top:9px">About <%= (typeof selectedDomain !=='undefined' && selectedDomain) ? selectedDomain
              : 'Domain' %>
          </h2>
          <!-- <p>
            <% if (typeof selectedDomain !=='undefined' && selectedDomain) { %><strong>
                <%= selectedDomain %>
              </strong> is a disposable email domain<% if (typeof selectedProvider !=='undefined' && selectedProvider) {
                %> associated with <strong>
                  <%= selectedProvider %>
                </strong>
                <% } %>. StopReg identifies <%= selectedDomain %> as a disposable email domain and provides information
                    to
                    help websites recognize and manage registrations using temporary email addresses.<% } else { %>No
                      domain selected.<% } %>
          </p> -->
          <p><%= domainOverview %></p>
          <div class="overview-meta">
            <div><span>Domain Age</span><strong>
                <%= (typeof domainAge !== 'undefined') ? domainAge : 'N/A' %>
              </strong></div>
            <div><span>Last Seen</span><strong>
                <%= (typeof domainDetails !=='undefined' && domainDetails && domainDetails.updatedAt) ? new
                  Date(domainDetails.updatedAt).toLocaleDateString() : 'N/A' %>
              </strong></div>
            <div><span>Free Subdomain</span><strong>
                <%= (typeof domainDetails !=='undefined' && domainDetails && domainDetails.classification &&
                  domainDetails.classification.is_free_subdomain===true) ? 'Yes' : 'No' %>
              </strong></div>
            <div><span>Provider</span><strong>
                <%= (typeof domainDetails !=='undefined' && domainDetails && domainDetails.provider) ? domainDetails.provider : 'N/A' %>
              </strong></div>
          </div>
        </div>

        <div class="card">
          <div class="cardhead">
            <div><span class="eyebrow">SUBDOMAIN DIRECTORY</span>
              <h2 style="margin-top:9px">Subdomains of <%= (typeof selectedDomain !=='undefined' && selectedDomain) ?
                  selectedDomain : 'Domain' %>
              </h2>
              <p>Discovered subdomains associated with this root domain.</p>
            </div><span class="badge gray"><%= (typeof subdomainsPagination !=='undefined' && subdomainsPagination && subdomainsPagination.total) ? subdomainsPagination.total : 0 %> discovered</span>
          </div>
          <div class="subdomain-toolbar">
            <div class="subdomain-count"><span>Total subdomains</span><strong><%= (typeof subdomainsPagination !=='undefined' && subdomainsPagination && subdomainsPagination.total) ? subdomainsPagination.total : 0 %></strong></div>
            <div class="controls">
              <div class="viewtoggle"><button class="active"
                  onclick="setView('subdomains','table',this)">Table</button><button
                  onclick="setView('subdomains','grid',this)">Grid</button></div>
            </div>
          </div>

          <div id="subdomains-table" class="tableview">
            <div class="tablewrap">
              <table class="table">
                <thead>
                  <tr>
                    <th>Subdomain</th>
                    <th>Root Domain</th>
                    <th>Last checked</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (typeof subdomains !=='undefined' && subdomains && subdomains.length> 0) { %>
                    <% subdomains.forEach(function(sub) { %>
                      <tr>
                        <td>
                          <%= sub.subdomain || 'N/A' %>
                        </td>
                        <td>
                          <%= sub.domain || selectedDomain || 'N/A' %>
                        </td>
                        <td>
                          <%= sub.flagged_date ? new Date(sub.flagged_date).toLocaleDateString() : '-' %>
                        </td>
                      </tr>
                      <% }); %>
                        <% } else { %>
                          <tr>
                            <td colspan="3" style="text-align:center;padding:30px;color:var(--muted)">No subdomains
                              discovered
                              for
                              <%= (typeof selectedDomain !=='undefined' && selectedDomain) ? selectedDomain
                                : 'this domain' %>.
                            </td>
                          </tr>
                          <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <div id="subdomains-grid" class="gridview hidden">
            <% if (typeof subdomains !=='undefined' && subdomains && subdomains.length> 0) { %>
              <% subdomains.forEach(function(sub) { %>
                <a class="itemcard" href="#subdomain" data-search="<%= (sub.subdomain || '').toLowerCase() %>">
                  <div class="itemtop">
                    <div><span class="eyebrow">SUBDOMAIN</span>
                      <h3 style="margin-top:8px">
                        <%= sub.subdomain %>
                      </h3>
                    </div><span class="badge red">Disposable</span>
                  </div>
                  <p>Root: <%= sub.domain || selectedDomain || 'N/A' %></p>
                  <div class="itemmeta"><span><%= sub.flagged_date ? new Date(sub.flagged_date).toLocaleDateString() : '-' %></span></div>
                </a>
              <% }); %>
            <% } else { %>
              <div style="grid-column:1/-1;text-align:center;padding:30px;color:var(--muted)">No subdomains discovered for <%= (typeof selectedDomain !=='undefined' && selectedDomain) ? selectedDomain : 'this domain' %>.
              </div>
            <% } %>
          </div>
          <div class="pagination">
            <span class="muted">Showing <%= (typeof subdomainsPagination !=='undefined' && subdomainsPagination) ?
                subdomainsPagination.total : 0 %> subdomains</span>
            <div class="pages">
              <% if (typeof subdomainsPagination !=='undefined' && subdomainsPagination && subdomainsPagination.page> 1)
                { %>
                <button onclick="navigateSubdomainPage(<%= subdomainsPagination.page - 1 %>)">Previous</button>
                <% } else { %>
                  <button disabled style="opacity:0.5;cursor:not-allowed">Previous</button>
                  <% } %>
                    <% if (typeof subdomainsPagination !=='undefined' && subdomainsPagination &&
                      subdomainsPagination.page < subdomainsPagination.totalPages) { %>
                      <button onclick="navigateSubdomainPage(<%= subdomainsPagination.page + 1 %>)">Next</button>
                      <% } else { %>
                        <button disabled style="opacity:0.5;cursor:not-allowed">Next</button>
                        <% } %>
            </div>
          </div>
        </div>

        <div class="tier3-conversion-layout">
          <div class="tier3-validation-column">
            <div class="card api-response-card">
              <div class="cardhead">
                <div><span class="eyebrow">API RESPONSE</span>
                  <h2 style="margin-top:9px">Domain validation result</h2>
                  <p>The same intelligence shown on this page can be returned through the StopReg API.</p>
                </div>
                <button class="btn copy-json" onclick="copyDomainJson(this)" aria-label="Copy JSON response">⧉ Copy
                  JSON</button>
              </div>
              <pre id="domain-json" class="code"><code>{
  "input": {
    "suggestion": <%= (typeof classification !== 'undefined' && classification && classification.suggestion) ? JSON.stringify(classification.suggestion) : 'null' %>,
    "domain": "<%= (typeof selectedDomain !== 'undefined' && selectedDomain) ? selectedDomain : '' %>"
  },
  "domain": {
    "root": "<%= domainDetails?.root %>",
    "is_subdomain": <%= domainDetails?.is_subdomain %>,
    "email_provider": <%= JSON.stringify((typeof selectedProvider !== 'undefined' && selectedProvider) ? selectedProvider : ((typeof domainDetails !== 'undefined' && domainDetails && domainDetails.provider) ? domainDetails.provider : null)) %>
  },
  "mail_server": {
    "mx_found": <%= (typeof dnsData !== 'undefined' && dnsData && dnsData.mxRecords && dnsData.mxRecords.length > 0) ? 'true' : 'false' %>,
    "mx_records": <%- JSON.stringify((typeof dnsData !== 'undefined' && dnsData && dnsData.mxRecords) ? dnsData.mxRecords : [], null, 4) %>,
    "mx_provider": <%- JSON.stringify(domainDetails?.mx_provider) %>
  },
  "classification": {
    "is_disposable": <%= (typeof classification !== 'undefined' && classification && classification.is_disposable === true) ? 'true' : 'false' %>,
    "is_relay": <%= (typeof classification !== 'undefined' && classification && classification.is_relay === true) ? 'true' : 'false' %>,
    "is_private": <%= (typeof classification !== 'undefined' && classification && classification.is_private === true) ? 'true' : 'false' %>,
    "is_public": <%= (typeof classification !== 'undefined' && classification && classification.is_public === true) ? 'true' : 'false' %>,
    "is_role_based": <%= (typeof classification !== 'undefined' && classification && classification.is_role_based === true) ? 'true' : 'false' %>,
    "is_alias": <%= (typeof classification !== 'undefined' && classification && classification.is_alias === true) ? 'true' : 'false' %>,
    "alias_method": <%= (typeof classification !== 'undefined' && classification && classification.alias_method) ? JSON.stringify(classification.alias_method) : 'null' %>,
    "is_edu": <%= (typeof classification !== 'undefined' && classification && classification.is_edu === true) ? 'true' : 'false' %>,
    "is_isp": <%= (typeof classification !== 'undefined' && classification && classification.is_isp === true) ? 'true' : 'false' %>,
    "is_free_subdomain": <%= (typeof classification !== 'undefined' && classification && classification.is_free_subdomain === true) ? 'true' : 'false' %>
  },
  "list_match": {
    "blocklisted": "Login to configure the blocklist",
    "block_source": null,
    "allowlisted": "Login to configure the allowlist"
  },
  "policy": {
    "action": "block",
    "reason_code": "DISPOSABLE_DOMAIN",
    "reason": "Domain is used for temporary email addresses",
    "risk": "high"
  }
}</code></pre>
            </div>
