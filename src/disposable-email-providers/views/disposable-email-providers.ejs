            1. Is <%= (typeof selectedDomain !=='undefined' && selectedDomain) ? selectedDomain : 'this domain' %> a
              disposable email domain?
              <span class="accordion-icon" aria-hidden="true">
                <img src="/assets/icons/drop-down.svg" alt="" />
              </span>
