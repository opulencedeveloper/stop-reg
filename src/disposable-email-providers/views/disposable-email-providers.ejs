                  <% mxRecords.forEach(function(mx) { %>
                    <tr>
                      <td><%= mx.priority %></td>
                      <td><%= mx.hostname %></td>
                      <td><%= (mx.ips && mx.ips.length > 0) ? mx.ips[0] : 'N/A' %></td>
                      <td>N/A</td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="4" style="text-align:center; padding:25px; color:var(--muted)">
                      No MX records found for <%= (typeof selectedDomain !== 'undefined' && selectedDomain) ? selectedDomain : 'this domain' %>.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="dns-note"><span class="dns-info">!</span><span>MX records indicate that this domain can receive
              emails</span></div>

